# Maestro Environment Configuration
# Copy to .env and fill in your values

# Required: Anthropic API key for running agents via Claude
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Data directory (default: ~/.maestro)
# MAESTRO_DATA_DIR=/path/to/your/maestro/data

# Optional: Path to agent-builder directory (default: auto-detected relative to runtime/)
# MAESTRO_AGENT_BUILDER_DIR=/path/to/maestro/agent-builder

# Optional: Default model for agent execution (default: claude-sonnet-4-6)
# MAESTRO_DEFAULT_MODEL=claude-sonnet-4-6

# Optional: Enable FastAPI server mode
# MAESTRO_API_HOST=0.0.0.0
# MAESTRO_API_PORT=8000
